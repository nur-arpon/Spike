<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: the app icon on the app's own background colour,
     so the hand-off to the first Flutter frame is seamless. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#17110D</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#4A3326</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
