# Copy this file to .env (same folder) and fill in only what you use.
# .env is git-ignored. Nothing here is needed for normal, fully local use.

# Pairing token for a real robot on Wi-Fi (the brain then listens on the
# network and refuses robots without this token). Any long random string.
SPIKE_TOKEN=

# OPTIONAL cloud fallback. Also set [cloud] enabled = true in
# spike_settings.toml. Only text is ever sent, never audio or video.
GEMINI_API_KEY=
